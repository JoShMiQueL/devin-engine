{
  "name": "devin-engine",
  "version": "0.0.1",
  "description": "Embeddable compliance engine over devin-core \u00e2\u20ac\u201d guarded-retry pipeline, system-override injection, refusal guard, sanitize, pruning, model resolution. A class, not a server.",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "prompts"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "test": "bun test",
    "typecheck": "tsc --noEmit",
    "prepare": "bun run build"
  },
  "keywords": [
    "devin",
    "cognition",
    "swe",
    "jailbreak",
    "proxy"
  ],
  "license": "MIT",
  "author": {
    "name": "JoShMiQueL",
    "email": "joshmiquel.cs@gmail.com"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/JoShMiQueL/devin-engine.git"
  },
  "dependencies": {
    "devin-core": "file:../devin-core"
  },
  "devDependencies": {
    "@types/bun": "^1.4.4",
    "typescript": "^7.0.2",
    "@types/node": "^26.6.7"
  }
}